<Window x:Class="GameLibrary.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Game Library" Icon="/Assets/GameLibraryLogo.ico" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="10"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderBrush" Value="#343B4C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="#202635"/>
   <Setter Property="Foreground" Value="#E7EAF2"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
   <Style.Triggers>
    <EventTrigger RoutedEvent="Mouse.MouseEnter">
     <BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.14"/>
      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.14"/>
     </Storyboard></BeginStoryboard>
    </EventTrigger>
    <EventTrigger RoutedEvent="Mouse.MouseLeave">
     <BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
     </Storyboard></BeginStoryboard>
    </EventTrigger>
    <Trigger Property="IsKeyboardFocused" Value="True">
     <Setter Property="BorderBrush" Value="#FFFFFF"/>
     <Setter Property="BorderThickness" Value="2"/>
     <Setter Property="Effect">
      <Setter.Value><DropShadowEffect Color="#FFFFFF" BlurRadius="17" ShadowDepth="0" Opacity="0.8"/></Setter.Value>
     </Setter>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="BorderBrush" Value="#8F75D9"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#F4F5FA"/>
   <Setter Property="Background" Value="#171C28"/>
   <Setter Property="BorderBrush" Value="#303849"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True">
     <Setter Property="BorderBrush" Value="#FFFFFF"/>
     <Setter Property="BorderThickness" Value="2"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="GameCard">
   <Border Width="190" Margin="0,0,16,10" CornerRadius="13" Background="#151A25"
           BorderBrush="#292F3D" BorderThickness="1" GotKeyboardFocus="GameCard_GotKeyboardFocus">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="BorderBrush" Value="#292F3D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#151A25"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
      <Style.Triggers>
       <EventTrigger RoutedEvent="Mouse.MouseEnter">
        <BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.18"/>
         <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.18"/>
        </Storyboard></BeginStoryboard>
       </EventTrigger>
       <EventTrigger RoutedEvent="Mouse.MouseLeave">
        <BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
         <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
        </Storyboard></BeginStoryboard>
       </EventTrigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#202638"/>
        <Setter Property="Effect">
         <Setter.Value><DropShadowEffect Color="#FFFFFF" BlurRadius="22" ShadowDepth="0" Opacity="0.8"/></Setter.Value>
        </Setter>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="#7860BD"/>
        <Setter Property="Background" Value="#1B2030"/>
       </Trigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="205"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#242B3A" CornerRadius="12,12,0,0" ClipToBounds="True">
      <Grid>
       <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
       <TextBlock Text="SEM CAPA" Foreground="#8C96AA" FontSize="9" FontWeight="Bold"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding CoverPath}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding CoverPath}" Value="">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <Border VerticalAlignment="Bottom" Height="54">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
         <GradientStop Color="#0010141D" Offset="0"/><GradientStop Color="#CC10141D" Offset="1"/>
        </LinearGradientBrush></Border.Background>
       </Border>
      </Grid>
     </Border>
     <StackPanel Grid.Row="1" Margin="12,12,12,12">
      <TextBlock Text="{Binding Name}" Foreground="#F4F5FA" FontSize="12" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding PlaytimeText}" Foreground="#929CAF" FontSize="9" Margin="0,5,0,12"/>
      <Button Content="▶  JOGAR" Tag="{Binding}" Click="PlayGame_Click"
              Background="#7956D6" BorderBrush="#9273E8" Foreground="White"
              Padding="10,9" FontSize="9"/>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Background="#0D1018" MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
    <Image Source="/Assets/GameLibraryLogo.ico" Width="19" Height="19" Margin="0,0,9,0"/>
    <TextBlock Text="GAME LIBRARY" Foreground="#DDE1EC" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="—" Width="44" Height="38" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#AAB2C2" FontSize="15" Click="MinimizeWindow_Click"/>
    <Button Content="□" Width="44" Height="38" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#AAB2C2" FontSize="13" Click="MaximizeWindow_Click"/>
    <Button Content="✕" Width="48" Height="38" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#AAB2C2" FontSize="13" Click="CloseWindow_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#10131C" BorderBrush="#252B38" BorderThickness="0,0,1,0">
   <Grid Margin="20,24,20,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <Border Width="54" Height="54" CornerRadius="15" Background="#211B35" BorderBrush="#4C3A78" BorderThickness="1" HorizontalAlignment="Left">
      <Image Source="/Assets/GameLibraryLogo.jpg" Stretch="Uniform" Margin="5"/>
     </Border>
     <TextBlock Text="GAME LIBRARY" Foreground="#F7F6FC" FontSize="15" FontWeight="Bold" Margin="0,15,0,3"/>
     <TextBlock Text="SEU UNIVERSO DE JOGOS" Foreground="#777F91" FontSize="8" FontWeight="Bold"/>
     <Border Height="1" Background="#252B38" Margin="0,24,0,22"/>
     <TextBlock Text="MENU PRINCIPAL" Foreground="#687286" FontSize="8" FontWeight="Bold" Margin="8,0,0,11"/>
     <Button Content="⌂   Início" Style="{StaticResource NavButton}" Background="#252039" Foreground="#D9CEFF" BorderBrush="#4A3B70"/>
     <Button Content="▦   Minha biblioteca" Style="{StaticResource NavButton}" Click="FocusFirstGameAction_Click"/>
     <Button Content="◷   Estatísticas" Style="{StaticResource NavButton}" Click="Statistics_Click"/>
     <TextBlock Text="GERENCIAMENTO" Foreground="#687286" FontSize="8" FontWeight="Bold" Margin="8,25,0,10"/>
     <Button Content="＋   Adicionar jogo" Style="{StaticResource NavButton}" Click="AddGame_Click"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#171C28" BorderBrush="#2B3242" BorderThickness="1" CornerRadius="12" Padding="13">
     <StackPanel>
      <TextBlock Text="STATUS DO SISTEMA" Foreground="#BBA7FF" FontSize="8" FontWeight="Bold"/>
      <TextBlock Text="Biblioteca local" Foreground="#E5E8F0" FontSize="10" FontWeight="SemiBold" Margin="0,7,0,2"/>
      <TextBlock Text="Seus jogos e dados ficam salvos neste computador." Foreground="#858FA2" FontSize="9" TextWrapping="Wrap" LineHeight="15"/>
      <Border Height="1" Background="#2A3040" Margin="0,12,0,9"/>
      <TextBlock x:Name="ControllerStatusText" Text="CONTROLE: procurando..." Foreground="#A9AFC0" FontSize="8" TextWrapping="Wrap" LineHeight="13"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,28,34,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="285"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,23">
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="PAINEL INICIAL" Foreground="#A98CF8" FontSize="9" FontWeight="Bold"/>
     <TextBlock Text="Sua biblioteca de jogos" Foreground="#F5F5F9" FontSize="26" FontWeight="Bold" Margin="0,5,0,2"/>
     <TextBlock Text="Tudo o que você joga, organizado em um só lugar." Foreground="#8993A6" FontSize="11"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBox x:Name="SearchBox" Width="225" Height="39" Margin="0,0,10,0" ToolTip="Pesquisar jogos" TextChanged="SearchBox_TextChanged"/>
     <Button x:Name="FullscreenButton" Content="⛶  TELA CHEIA" Margin="0,0,9,0"
             Background="#1B2130" BorderBrush="#303849" Padding="13,10"
             Click="ToggleFullscreen_Click"/>
     <Button Content="+  ADICIONAR" Style="{StaticResource PrimaryButton}" Click="AddGame_Click"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#171C28" CornerRadius="17" ClipToBounds="True" BorderBrush="#343047" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#6F51C7" BlurRadius="28" ShadowDepth="0" Opacity="0.16"/></Border.Effect>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Grid.Column="0" Background="#222A39">
      <Image x:Name="HeroCover" Stretch="UniformToFill"/>
      <Rectangle>
       <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0010141D" Offset="0"/><GradientStop Color="#3310141D" Offset="0.55"/><GradientStop Color="#DD171C28" Offset="1"/>
       </LinearGradientBrush></Rectangle.Fill>
      </Rectangle>
      <Border Background="#3310141D" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="7"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="9,5">
       <TextBlock Text="JOGO EM DESTAQUE" Foreground="#F1EAFE" FontSize="8" FontWeight="Bold"/>
      </Border>
     </Grid>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,20,34,20">
      <TextBlock Text="✦  SELEÇÃO DA BIBLIOTECA" Foreground="#BCA8FF" FontSize="9" FontWeight="Bold"/>
      <TextBlock x:Name="HeroTitle" Text="Sua biblioteca está vazia" Foreground="#FFFFFF" FontSize="29" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,7"/>
      <TextBlock x:Name="HeroPlaytime" Text="Adicione um jogo para começar" Foreground="#A4AEC0" FontSize="11" Margin="0,0,0,9"/>
      <TextBlock x:Name="HeroPath" Text="Seus jogos aparecerão aqui." Foreground="#727E92" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,0,21"/>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="HeroPlayButton" Content="▶  JOGAR AGORA" Click="PlayFeatured_Click" Style="{StaticResource PrimaryButton}" Padding="21,13" Margin="0,0,10,0"/>
       <Button Content="TROCAR CAPA" Click="ChangeFeaturedCover_Click" Background="#252C3B" BorderBrush="#3A4355" Padding="15,12" FontSize="9"/>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,24,0,14">
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="SUA COLEÇÃO" Foreground="#F4F5FA" FontSize="15" FontWeight="Bold"/>
     <TextBlock Text="Acesse e inicie seus jogos instalados." Foreground="#818CA0" FontSize="9" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Border Background="#171C28" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal"><TextBlock Text="JOGOS  " Foreground="#8993A6" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="GameCountText" Text="0" Foreground="#F2EEFF" FontSize="10" FontWeight="Bold"/></StackPanel>
     </Border>
     <Border Background="#171C28" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="8" Padding="12,8">
      <StackPanel Orientation="Horizontal"><TextBlock Text="TEMPO TOTAL  " Foreground="#8993A6" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="TotalTimeText" Text="0 min" Foreground="#F2EEFF" FontSize="10" FontWeight="Bold"/></StackPanel>
     </Border>
     <TextBlock x:Name="NowPlayingText" Text="Nenhum" Foreground="#B99CFF" FontSize="9" VerticalAlignment="Center" Margin="14,0,0,0"/>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
    <ItemsControl x:Name="GamesItems" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCard}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </ScrollViewer>
   <Grid Grid.Row="4" Margin="0,12,0,0">
    <TextBlock x:Name="StatusText" Foreground="#7D879A" FontSize="9" VerticalAlignment="Center"/>
    <TextBlock Text="← → NAVEGAR     A / ENTER JOGAR     B / ESC VOLTAR     LB / RB SEÇÕES" Foreground="#596476" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
 </Grid>
 </Grid>
</Window>