<Window x:Class="GameLibrary.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Game Library" Width="1320" Height="820" MinWidth="1000" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A78BFA"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers></Style>
  <DataTemplate x:Key="GameCard">
   <Border Width="190" Margin="0,0,18,20" Background="#171B24" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" ClipToBounds="True">
    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A78BFA"/><Setter Property="BorderThickness" Value="3"/></Trigger></Style.Triggers></Style></Border.Style>
    <StackPanel>
     <Grid Height="210" Background="#252B38">
      <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
      <TextBlock Text="SEM CAPA" Foreground="#7D8698" FontSize="10"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
     <StackPanel Margin="13,12">
      <TextBlock Text="{Binding Name}" Foreground="#F5F5F8" FontSize="13" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding PlaytimeText}" Foreground="#8F98A9" FontSize="9" Margin="0,5,0,12"/>
      <Grid>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="7"/><RowDefinition/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button Grid.ColumnSpan="3" Content="JOGAR" Tag="{Binding}" Click="PlayGame_Click" Style="{StaticResource PrimaryButton}"/>
       <Button Grid.Row="2" Content="TROCAR CAPA" Tag="{Binding}" Click="ChangeCover_Click"
               Background="#292E3A" Foreground="#D5D9E2" BorderThickness="0" Padding="5,9" FontSize="9" Cursor="Hand"/>
       <Button Grid.Row="2" Grid.Column="2" Content="REMOVER" Tag="{Binding}" Click="RemoveGame_Click"
               Background="#292E3A" Foreground="#D5D9E2" BorderThickness="0" Padding="5,9" FontSize="9" Cursor="Hand"/>
      </Grid>
     </StackPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
   <StackPanel Margin="20,24">
    <TextBlock Text="GAME LIBRARY" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,38"/>
    <TextBlock Text="MENU PRINCIPAL" Foreground="#697386" FontSize="9" Margin="8,0,0,9"/>
    <Button Content="▦   Biblioteca" Style="{StaticResource NavButton}" Background="#252039" Foreground="#CBB9FF"/>
    <Button Content="◷   Estatísticas" Style="{StaticResource NavButton}" Click="Statistics_Click"/>
    <Button Content="＋   Adicionar jogo" Style="{StaticResource NavButton}" Click="AddGame_Click" Margin="0,25,0,0"/>
    <Border Background="#1A202B" CornerRadius="10" Padding="12" Margin="0,240,0,0">
     <StackPanel>
      <TextBlock Text="MODO LOCAL" Foreground="#BFA8FF" FontSize="9" FontWeight="Bold"/>
      <TextBlock Text="Sem conta e sem login." Foreground="#A0A8B7" FontSize="10" Margin="0,5,0,0"/>
      <TextBlock Text="Seus dados ficam neste PC." Foreground="#737D8F" FontSize="9" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,22">
    <StackPanel>
     <TextBlock Text="Sua biblioteca" Foreground="#F5F5F8" FontSize="27" FontWeight="Bold"/>
     <TextBlock Text="Todos os seus jogos em um só lugar." Foreground="#8F98A9" FontSize="12" Margin="0,6,0,0"/>
     <TextBlock x:Name="ControllerStatusText" Text="CONTROLE: XInput | D-pad/analógico: mover • A: confirmar • B: voltar • START: adicionar • Y: estatísticas • X: tela cheia" Foreground="#8F98A9" FontSize="9" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="FullscreenButton" Content="TELA CHEIA" Margin="0,0,8,0"
             Background="#292E3A" Foreground="#D5D9E2" BorderThickness="0" Padding="14,10"
             FontSize="10" FontWeight="Bold" Cursor="Hand" Click="ToggleFullscreen_Click"/>
     <Button Content="+ ADICIONAR JOGO" Style="{StaticResource PrimaryButton}" Click="AddGame_Click"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#171B24" CornerRadius="10" Padding="16" Margin="0,0,0,18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="JOGOS" Foreground="#8791A2" FontSize="9"/><TextBlock x:Name="GameCountText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="TEMPO TOTAL" Foreground="#8791A2" FontSize="9"/><TextBlock x:Name="TotalTimeText" Text="0 min" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="JOGANDO AGORA" Foreground="#8791A2" FontSize="9"/><TextBlock x:Name="NowPlayingText" Text="Nenhum" Foreground="White" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox x:Name="SearchBox" Grid.Row="0" Height="38" Margin="0,0,0,16" Padding="12,8"
             Background="#171B24" Foreground="#F5F5F8" BorderBrush="#303746" CaretBrush="White"
             FontSize="12" ToolTip="Pesquisar jogos" TextChanged="SearchBox_TextChanged"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
     <ItemsControl x:Name="GamesItems" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCard}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#707A8B" FontSize="10" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
