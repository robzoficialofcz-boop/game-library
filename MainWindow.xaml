<Window x:Class="GameLibrary.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Game Library" Width="1320" Height="820" MinWidth="1000" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True">
     <Setter Property="BorderBrush" Value="#FFFFFF"/>
     <Setter Property="BorderThickness" Value="3"/>
     <Setter Property="Effect">
      <Setter.Value><DropShadowEffect Color="#FFFFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/></Setter.Value>
     </Setter>
    </Trigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="GameCard">
   <Border Width="174" Margin="0,0,14,8" CornerRadius="12"
           GotKeyboardFocus="GameCard_GotKeyboardFocus">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="BorderBrush" Value="#292F3B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#171B24"/>
      <Style.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Background" Value="#242A36"/>
        <Setter Property="Effect">
         <Setter.Value><DropShadowEffect Color="#FFFFFF" BlurRadius="26" ShadowDepth="0" Opacity="1"/></Setter.Value>
        </Setter>
       </Trigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <StackPanel>
     <Border Height="190" Background="#252B38" CornerRadius="11,11,0,0" ClipToBounds="True">
      <Grid>
       <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
       <TextBlock Text="SEM CAPA" Foreground="#7D8698" FontSize="10"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <StackPanel Margin="11,10,11,11">
      <TextBlock Text="{Binding Name}" Foreground="#F5F5F8" FontSize="12" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding PlaytimeText}" Foreground="#8F98A9" FontSize="8" Margin="0,4,0,10"/>
      <Button Content="JOGAR" Tag="{Binding}" Click="PlayGame_Click"
              Background="#8057E8" Foreground="White" BorderThickness="0"
              Padding="10,8" FontSize="9" FontWeight="Bold"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#090A10" Offset="0"/>
    <GradientStop Color="#11101D" Offset="0.48"/>
    <GradientStop Color="#090B12" Offset="1"/>
   </LinearGradientBrush>
  </Grid.Background>
  <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
           Margin="0,-260,-190,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush>
    <GradientStop Color="#553F16A8" Offset="0"/>
    <GradientStop Color="#223F16A8" Offset="0.48"/>
    <GradientStop Color="#003F16A8" Offset="1"/>
   </RadialGradientBrush></Ellipse.Fill>
   <Ellipse.Effect><BlurEffect Radius="48"/></Ellipse.Effect>
  </Ellipse>
  <Ellipse Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom"
           Margin="100,0,0,-260" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush>
    <GradientStop Color="#333B1B75" Offset="0"/>
    <GradientStop Color="#003B1B75" Offset="1"/>
   </RadialGradientBrush></Ellipse.Fill>
   <Ellipse.Effect><BlurEffect Radius="54"/></Ellipse.Effect>
  </Ellipse>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#D90C0E15" BorderBrush="#202431" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,24">
    <StackPanel DockPanel.Dock="Top">
     <Image Source="/Assets/GameLibraryLogo.jpg" Width="126" Height="126"
            Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,18"/>
     <TextBlock Text="GAME LIBRARY" Foreground="White" FontSize="16" FontWeight="Bold" Margin="5,4,0,30"/>
     <TextBlock Text="NAVEGAR" Foreground="#626C7D" FontSize="9" FontWeight="Bold" Margin="8,0,0,12"/>
     <Button Content="⌂   Início" Style="{StaticResource NavButton}" Background="#29213F" Foreground="#D4C5FF"/>
     <Button Content="▦   Biblioteca" Style="{StaticResource NavButton}" Click="FocusFirstGameAction_Click"/>
     <Button Content="◷   Estatísticas" Style="{StaticResource NavButton}" Click="Statistics_Click"/>
     <Button Content="＋   Adicionar jogo" Style="{StaticResource NavButton}" Click="AddGame_Click" Margin="0,22,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#191E28" CornerRadius="10" Padding="12" Margin="0,18,0,0">
     <StackPanel>
      <TextBlock Text="MODO LOCAL" Foreground="#BFA8FF" FontSize="9" FontWeight="Bold"/>
      <TextBlock Text="Seus jogos e dados ficam neste PC." Foreground="#8993A4" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="ControllerStatusText" Text="CONTROLE: procurando..." Foreground="#737D8F" FontSize="8" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="270"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,18">
    <StackPanel>
     <TextBlock Text="GAME LIBRARY" Foreground="#F5F5F8" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="Escolha seu próximo jogo." Foreground="#8993A4" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBox x:Name="SearchBox" Width="210" Height="36" Padding="10,7" Margin="0,0,9,0"
              Background="#171B24" Foreground="#F5F5F8" BorderBrush="#303746" CaretBrush="White"
              FontSize="11" ToolTip="Pesquisar jogos" TextChanged="SearchBox_TextChanged"/>
     <Button x:Name="FullscreenButton" Content="TELA CHEIA" Margin="0,0,8,0"
             Background="#292E3A" Foreground="#D5D9E2" BorderThickness="0" Padding="12,9"
             FontSize="9" FontWeight="Bold" Click="ToggleFullscreen_Click"/>
     <Button Content="+ ADICIONAR" Style="{StaticResource PrimaryButton}" Click="AddGame_Click"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#171B24" CornerRadius="16" ClipToBounds="True" BorderBrush="#45405C" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="34" ShadowDepth="0" Opacity="0.22"/></Border.Effect>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#252B38" ClipToBounds="True">
      <Grid>
       <Image x:Name="HeroCover" Stretch="UniformToFill"/>
       <Rectangle>
        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
         <GradientStop Color="#0010141D" Offset="0"/>
         <GradientStop Color="#3310141D" Offset="0.58"/>
         <GradientStop Color="#CC171B24" Offset="1"/>
        </LinearGradientBrush></Rectangle.Fill>
       </Rectangle>
      </Grid>
     </Border>
     <Border Grid.Column="0" Background="#330B0E14"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,18,28,18">
      <TextBlock Text="✦  DESTAQUE DA SUA BIBLIOTECA" Foreground="#D1BFFF" FontSize="9" FontWeight="Bold"/>
      <TextBlock x:Name="HeroTitle" Text="Sua biblioteca" Foreground="#FFFFFF" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,5"/>
      <TextBlock x:Name="HeroPlaytime" Text="Adicione jogos para começar" Foreground="#9AA4B5" FontSize="11" Margin="0,0,0,8"/>
      <TextBlock x:Name="HeroPath" Text="Seus jogos em um só lugar." Foreground="#737E90" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,0,18"/>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="HeroPlayButton" Content="▶  JOGAR AGORA" Click="PlayFeatured_Click" Style="{StaticResource PrimaryButton}" Padding="20,12" Margin="0,0,9,0"/>
       <Button Content="TROCAR CAPA" Click="ChangeFeaturedCover_Click" Background="#303746" Foreground="#E0E3EA" BorderThickness="0" Padding="14,12" FontSize="9"/>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,20,0,12">
    <TextBlock Text="SUA COLEÇÃO" Foreground="#F5F5F8" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock x:Name="GameCountText" Text="0 JOGOS" Foreground="#8F98A9" FontSize="9" VerticalAlignment="Center" Margin="0,0,18,0"/>
     <TextBlock x:Name="TotalTimeText" Text="0 min jogados" Foreground="#8F98A9" FontSize="9" VerticalAlignment="Center" Margin="0,0,18,0"/>
     <TextBlock x:Name="NowPlayingText" Text="Nenhum" Foreground="#B99CFF" FontSize="9" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
    <ItemsControl x:Name="GamesItems" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCard}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </ScrollViewer>
   <Grid Grid.Row="4" Margin="0,10,0,0">
    <TextBlock x:Name="StatusText" Foreground="#707A8B" FontSize="9" VerticalAlignment="Center"/>
    <TextBlock Text="← → NAVEGAR     A / ENTER JOGAR     B / ESC VOLTAR     LB / RB SEÇÕES" Foreground="#596476" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
 </Grid>
</Window>